    <script type="text/javascript">
    TM.namespace("Shared.SessionTimeout");

    Shared.SessionTimeout = (function () {
        var saveActions = [
            'UIAssessmentObject.500', // Assessment + Project + IssueTracking
            'AssessmentSelfAssessment.24200', // Assessment -> SelfAssessment admin
            'SelfAssessmentWork.SaveManagementItem', // SelfAssessment
            'UIProjectObject.2300', // Project -> Profile
        ]
        var currentTimeoutUrl = '/TeamMate/Home/CurrentTimeout';
        var logoutTimeoutUrl = '/TeamMate/Home/LogOutTimeout';
        var authenticationTimeoutUrl = '/TeamMate/Home/AuthenticationTimeOut';

        var workpaperAuthKeepAlive = false;
        var currentTimeoutRetryCounter = 0;

        //This function sets the timeout on when the user is going
        //to get the warning message.
        function setTimeoutWarningMessage(renewSession) {

            if (Layout.Timeout.timeoutSession != null) {
                clearTimeout(Layout.Timeout.timeoutSession);
            }

            getCurrentTimeout(renewSession).done(function (timeoutObj) {

                currentTimeoutRetryCounter = 0;
                logCurrentTimeout(renewSession, timeoutObj);
                if (timeoutObj.CognosDomainUrl != undefined) {
                    cognosLogoutUrl = timeoutObj.CognosDomainUrl;
                }
                if (timeoutObj.WorkpaperAuthKeepAlive != undefined) {
                    workpaperAuthKeepAlive = timeoutObj.WorkpaperAuthKeepAlive;
                }

                //if web.config is not configured with timeout settings, don't set the timeout.
                if (timeoutObj.AuthenticationTimeout > 0 && timeoutObj.TimeoutWarning > 0) {

                    //time to show the message before the application expires.
                    var showMessageAtMinutes = timeoutObj.AuthenticationTimeout - timeoutObj.TimeoutWarning;
                    if (showMessageAtMinutes > 0) {
                        Layout.Timeout.timeoutSession = setTimeout(function () {
                            //Get timeout.
                            getCurrentTimeout(false).done(function (timeoutObjRefresh) {
                                currentTimeoutRetryCounter = 0;
                                logCurrentTimeout(false, timeoutObjRefresh);

                                var slidingExp = JSON.parse(String(timeoutObjRefresh.SlidingExpiration).toLowerCase());
                                var messageformat;
                                //when sliding expiration is set to true, session can be renew.
                                if (slidingExp) {
                                    //if user's session was renew, don't show message and refresh timeoutinfo.
                                    if (timeoutObjRefresh.AuthenticationTimeout <= timeoutObjRefresh.TimeoutWarning) {
                                        // if workpaper keepalive is enabled and we received a workpaperHeartbeat message, 
                                        // don't show user prompt dialog, just renew
                                        // TODO: may want some kind of upper limit to how long user will be renewed
                                        // also if user has activity in the last half of the timeout period we will automatically renew 
                                        if ((timeoutObjRefresh.WorkpaperAuthKeepAlive && Layout.Timeout.workpaperHeartbeatReceived) ||
                                            Layout.Timeout.WasUserActiveRecently(timeoutObjRefresh.ActivityAuthWindow)) {
                                            Layout.Timeout.workpaperHeartbeatReceived = false;
                                            setTimeoutWarningMessage(true);
                                        } else {

                                            messageformat = $.validator.format(TeamMate.Web.Resources.Common.SessionTimeoutWarningRenew);
                                            TM.Dialogs.showOKConfirmation(messageformat(timeoutObjRefresh.TimeoutWarning), TeamMate.Web.Resources.Common.SessionTimeoutWarning,
                                                function () { setTimeoutWarningMessage(true); });
                                            waitForRenewalOrLogoff(timeoutObj.AuthenticationTimeout);
                                        }
                                    } else {
                                        //reset timeout with the new updated time.
                                        setTimeoutWarningMessage(false);
                                    }
                                }
                                //when sliding expiration is set to false, users don't have the option to renew. so just show a warning message.
                                if (!slidingExp) {
                                    messageformat = $.validator.format(TeamMate.Web.Resources.Common.SessionTimeoutWarningWithoutRenew);
                                    if (showMessageAtMinutes > 0) {
                                        TM.Dialogs.showMessage(messageformat(timeoutObjRefresh.TimeoutWarning), TeamMate.Web.Resources.Common.SessionTimeoutWarning);
                                        waitForRenewalOrLogoff(timeoutObj.AuthenticationTimeout);
                                    }
                                }
                            })
                            .fail(function (jqXHR, textStatus, errorThrown) {
                                if (checkRetryCurrentTimeout(textStatus)) {
                                    setTimeoutWarningMessage(renewSession);
                                }
                            });

                        }, showMessageAtMinutes * 60 * 1000); //in milliseconds
                    }
                    clearTimeoutMessages();
                    SaveLogoutUser(timeoutObj);
                }
            })
            .fail(function (jqXHR, textStatus, errorThrown) {
                if (checkRetryCurrentTimeout(textStatus)) {
                    setTimeoutWarningMessage(renewSession);
                }
            });

        }

        function waitForRenewalOrLogoff(originalTimeout) {
            // keep checking current timeout every 5 seconds to see if we have renewed or we are now timed out
            getCurrentTimeout(false).done(function (timeoutObjRefresh) {
                currentTimeoutRetryCounter = 0;
                if (typeof timeoutObjRefresh == "object") {
                    logCurrentTimeout(false, timeoutObjRefresh);

                    if (timeoutObjRefresh.AuthenticationTimeout >= originalTimeout) {
                        console.log('timeout was renewed, cancelling timeout messages');
                        clearTimeoutMessages();
                        //reset timeout with the new updated time.
                        setTimeoutWarningMessage(false);
                    } else {
                        // wait another 5 seconds an check
                        //console.log('waitForRenewalOrLogoff ' + originalTimeout);
                        Layout.Timeout.waitForRenewalSession = setTimeout(function () { waitForRenewalOrLogoff(originalTimeout); }, 5000);
                    }
                } else {
                    // did we receive a login page instead of timeout object? if so, we are already logged out, so navigate to logged out page
                    window.location.href = authenticationTimeoutUrl;
                }
            })
            .fail(function (jqXHR, textStatus, errorThrown) {
                if (checkRetryCurrentTimeout(textStatus)) {
                    waitForRenewalOrLogoff(originalTimeout);
                }
            });
        }

        // clears timer used to watch timeout message dialogs and also hides any open dialogs
        function clearTimeoutMessages() {
            //console.log('clearTimeoutMessages');
            if (Layout.Timeout.waitForRenewalSession != null) {
                clearTimeout(Layout.Timeout.waitForRenewalSession);
                Layout.Timeout.waitForRenewalSession = null
            }
            TM.Dialogs.hideOKConfirmation();
            TM.Dialogs.hideMessage();
        }

        function checkRetryCurrentTimeout(textStatus) {
            // show message only on timeout, otherwise we will display the error in dialog elsewhere
            if (textStatus === "timeout") {
                if (++currentTimeoutRetryCounter >= 3) {
                    TM.Dialogs.showErrorOkDlg(TeamMate.Web.Resources.Common.ErrorTimeoutCommunication);
                    return false;
                } 
                // for timeout errors we will retry 3 times
                return true;
            }
            return false;
        }

        //Gets the CurrentTimeout information and renews session when applicable.
        function getCurrentTimeout(renewSession) {
            return TM.Ajax.jsonDataPromise(currentTimeoutUrl, { renew: renewSession }, 10000);
        }

        function logCurrentTimeout(renewFlag, timeoutObj) {
            if (typeof timeoutObj == "object") {
                console.log("CurrentTimeout renew:", renewFlag, " as of ", new Date().toLocaleString(), timeoutObj);
            }
        }

        function getWorkpaperAuthKeepAlive() {
            return workpaperAuthKeepAlive;
        }

        //this sets the timeout on when the user should be logout.
        function SaveLogoutUser(timeoutObj) {
            if (Layout.Timeout.logoutUser != null) {
                clearTimeout(Layout.Timeout.logoutUser);
            }

            var showMessageSeconds = timeoutObj.AuthenticationTimeout * 60 - timeoutObj.SaveUserData;

            // just before authentication times out, attempt to save data and log out user
            Layout.Timeout.logoutUser = setTimeout(saveAndLogOutUser, showMessageSeconds * 1000);
        }

        // This function is called from both legacy and Vue3 layouts.
        // To ensure the correct logout behavior, we check whether Shared.LayoutSpa or Shared.Layout is defined.
        function saveAndLogOutUser(actionUrl) {
            if (Shared.LayoutSpa) Shared.LayoutSpa.logOutUser(actionUrl ? actionUrl : logoutTimeoutUrl);
            else Shared.Layout.saveAndLogOutUser(actionUrl ? actionUrl : logoutTimeoutUrl, saveActions);
        }

        return {
            setTimeoutWarningMessage: setTimeoutWarningMessage,
            getCurrentTimeout: getCurrentTimeout,
            getWorkpaperAuthKeepAlive: getWorkpaperAuthKeepAlive,
            saveAndLogOutUser: saveAndLogOutUser
        };
    } ());

    </script>


<script type="text/javascript">

        

        

