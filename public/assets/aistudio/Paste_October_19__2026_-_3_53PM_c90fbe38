    recordMouseActivity: any = TM.Helper.debounce(function () { TM.Helper.setLocalStorage(TM.Helper.StorageKeys.LastMouseActivity, Date.now()); }, 5000, false),
    
    WasUserActiveRecently: any = function (activityAuthWindow) {
        try {
            // calculate beginning of renewal window and compare last activity dates
            var windowBegin = Date.now() - activityAuthWindow * 60000;
            var lastKey = Number(TM.Helper.getLocalStorage(TM.Helper.StorageKeys.LastKeyActivity));
            var lastMouse = Number(TM.Helper.getLocalStorage(TM.Helper.StorageKeys.LastMouseActivity));
            var lastNav = Number(TM.Helper.getLocalStorage(TM.Helper.StorageKeys.LastNavActivity));
            if (lastKey > windowBegin) {
                console.log('WasUserActiveRecently LastKeyActivity',lastKey, windowBegin);
                return true;
            }
            if (lastMouse > windowBegin) {
                console.log('WasUserActiveRecently LastMouseActivity',lastMouse, windowBegin);
                return true;
            }
            if (lastNav > windowBegin) {
                console.log('WasUserActiveRecently LastNavActivity',lastNav, windowBegin);
                return true;
            }
        } catch (e) { }
        return false;
    }
};

